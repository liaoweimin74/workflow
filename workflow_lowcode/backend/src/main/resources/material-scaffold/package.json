{
  "name": "material-scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/gen-manifest.mjs",
    "build:widget": "vite build --config vite.config.widget.js && node scripts/gen-manifest.mjs --manifest material-widget.json --dist dist/widget",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "element-plus": "^2.14.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.1.5"
  }
}
