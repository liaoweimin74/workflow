<script setup lang="ts">
import { reactive, ref } from 'vue'
import DashFilter from '@lc/runtime/dash-filter'
import DashTodo from '@lc/runtime/dash-todo'
import { getData, createData, updateData, deleteData } from './api/tmp-dash-todo-verify'

// ==================== 数据源（schema.dataSources[]）====================
const ds = { id: '', refId: '' }


// ==================== dash-filter 广播（运行期 dashInstances 语义）====================
// 渲染器把 emit(ready) 的组件实例收进 dashInstances，筛选器变更时按字段条件全量 setFilter
// （PageRendererPage.vue:263-278、505-549）。产物没有渲染器，这张表由产物自己持。
const dashInstances = new Set<any>()
function onDashReady(instance: any) {
  if (instance) dashInstances.add(instance)
}
function onFilterChange(payload: { field: string; op: string; value: unknown }) {
  if (!payload?.field) return
  const cond = { [payload.field]: payload.value === null ? null : { op: payload.op, value: payload.value } }
  for (const instance of dashInstances) {
    if (instance && typeof instance.setFilter === 'function') instance.setFilter(cond)
  }
}

</script>

