"<!-- 由 lc-codegen 从页面 schema 出码，勿手改登记表以外的部分；人工接管写在 handler 里 -->
<template>
  <div class="lc-page">
    <el-form class="lc-page-form" :inline="false" :hide-required-asterisk="false" label-position="top" size="default" label-width="auto">
      <!-- lc:node=n1 type=fcTable field= -->
      <table lc:node="n1" border="1" class="lc-fc-table">
        <tr>
          <td colspan="1" rowspan="1" style="width: 327px">
            <el-col class="fc-form-col" :span="24">
              <!-- lc:node=n1.f1 type=dash-todo field=todo1792330620798 slot=0:0 -->
              <el-form-item>
                <dash-todo lc:node="n1.f1" view="todo" :limit="8" order-by="priority" :span="24" height="100%" />
              </el-form-item>
            </el-col>
          </td>
          <td colspan="1" rowspan="1" style="width: 270px">
            <el-col class="fc-form-col" :span="24">
              <!-- lc:node=n1.f2 type=dash-kpi field=kpiDefCount slot=0:1 -->
              <el-form-item>
                <dash-kpi lc:node="n1.f2" title="流程定义数" subtitle="已部署流程定义" unit="个" agg="count" :ds-ref-id="ds.refId" :span="24" height="100%" />
              </el-form-item>
            </el-col>
          </td>
          <td colspan="1" rowspan="1">
            <el-col class="fc-form-col" :span="24">
              <!-- lc:node=n1.f3 type=dash-kpi field=kpiRunning slot=0:2 -->
              <el-form-item>
                <dash-kpi lc:node="n1.f3" title="运行中流程" subtitle="进行中的流程实例" unit="条" agg="count" :ds-ref-id="dataSources['ds_inst']" :filter="filter" :span="24" height="100%" />
              </el-form-item>
            </el-col>
          </td>
        </tr>
        <tr>
