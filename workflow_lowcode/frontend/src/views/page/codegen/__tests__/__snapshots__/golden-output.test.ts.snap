"<!-- 由 lc-codegen 从页面 schema 出码，勿手改登记表以外的部分；人工接管写在 handler 里 -->
<template>
  <div class="lc-page">
    <el-form class="lc-page-form" :inline="false" :hide-required-asterisk="false" label-position="right" size="default" label-width="125px">
      <el-row>
