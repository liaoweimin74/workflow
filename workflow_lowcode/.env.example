# ============================================================
# Docker 部署环境变量模板
#
# 用法：cp .env.example .env，再按现场改值。
# .env 已被忽略不入库（根 .gitignore 的 .env* 规则）；本模板文件被同一条规则命中，
# 首次提交需 `git add -f workflow_lowcode/.env.example`（backend-node/.env.example 同例）。
#
# 这个文件同时承担两件事：compose 的 ${WEB_PORT} 插值 + backend 容器的 env_file。
# Spring Boot 的环境变量宽松绑定会覆盖 application.yml 里的同名配置，因此不必改代码配置。
# ============================================================

# ---------- 对外端口 ----------
# 浏览器访问 http://<宿主机>:WEB_PORT
WEB_PORT=3000
# Java 后端 API 端口；不需要从宿主机直连 API 时可以删掉 compose 里的这行映射
API_PORT=8080

# ---------- MySQL（外部实例，不在 compose 内）----------
# 与 backend/src/main/resources/application.yml 的默认串同口径，只把主机换成容器可达地址：
#   - MySQL 跑在部署机上：host.docker.internal（compose 已配 host-gateway，Linux 也可用）
#   - MySQL 在独立服务器：直接填内网地址
# createDatabaseIfNotExist=true 需要账号有建库权限；已建好库时可去掉
# WSL2 + Docker（引擎装在 WSL 里、MySQL 跑在 Windows）：容器到不了本机 3306，要在 WSL 转一道。
#   mirrored 网络已占住本机 3306 在 WSL 侧的绑定，转发口只能另选（示例用 13306）：
#   socat TCP-LISTEN:13306,fork,reuseaddr,bind=172.17.0.1 TCP:127.0.0.1:3306
#   （nohup 起的会随 wsl 会话退出被回收，长期跑请配 systemd 单元）
#   然后 SPRING_DATASOURCE_URL 把主机写成 host.docker.internal:13306
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/workflow?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true&nullDatabaseMeansCurrent=true
SPRING_DATASOURCE_USERNAME=root
# 占位值，必须改成现网密码（含 # & 等特殊字符时整值加英文双引号）
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# ---------- JWT ----------
# 默认密钥随代码入库，生产必须替换：openssl rand -base64 48
# 换密钥会让已登录用户全部失效；如需与 Node 后端互认 token，两侧填同一个值
#JWT_SECRET=

# ---------- JVM ----------
# 容器内存受限时按比例给堆；也可写 -Xms512m -Xmx1024m
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# ---------- 日志 ----------
# 开发配置默认把 com.workflow 打到 DEBUG，部署时收紧
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_WORKFLOW=INFO

# ---------- AI 能力 ----------
# application.yml 默认 base-url 指向 Node(NestJS) 后端的内部 LLM 网关；本套编排只起
# Java 后端，该网关不存在，走默认值调用会失败。三选一：
#   1) 不填任何环境变量：部署后在「系统管理 → 模型配置」页面填端点/密钥/模型，保存即生效
#   2) 接外部 OpenAI 兼容服务（DeepSeek 等）：填下面三项
#   3) 彻底不提供 AI：WORKFLOW_AI_ENABLED=false（只关掉内置网关默认值；页面里存过
#      模型配置则以页面为准，助手不会因此报「未配置」）
# 下面三项都不设时 ChatModel bean 依然装配，不可用会在调用点即刻提示，不占启动。
#AI_BASE_URL=https://api.deepseek.com/v1
#AI_API_KEY=
#AI_MODEL=deepseek-chat
#WORKFLOW_AI_ENABLED=false

# ---------- 镜像仓库（发布用，见 scripts/image-release.sh） ----------
# 「打包即推远程」走 scripts/image-release.sh：compose build → 按 仓库/命名空间/前缀-服务名:tag
# 追加 tag（同时更新 latest）→ push。compose 的 image: 保持本地名，本地 up 不依赖这里。
# 密码不放这里！脚本只从环境变量 DOCKER_REPO_KEY 读（Windows 用户环境变量也能取到），
# 写进 .env 会被 compose 注入后端容器的环境变量，等于把仓库凭据留在运行态。
#ACR_REGISTRY=crpi-n1ozehviwgruhtx0.cn-hangzhou.personal.cr.aliyuncs.com
#ACR_NAMESPACE=<ACR 控制台里你那个命名空间的名字>
#ACR_USER=北京京控信息技术有限公司
#ACR_REPO_PREFIX=workflow-lowcode      # 仓库名 = 前缀-backend / 前缀-frontend
#IMAGE_TAG=                            # 缺省取 git 短 SHA（非 git 目录则用时间戳）

# ---------- 其他可选覆盖 ----------
# 逻辑节点 HTTP 出站白名单：默认空=放行全部，生产建议收紧为 api.example.com,*.example.com
#LOGIC_HTTP_ALLOWED_HOSTS=
# 小程序登录（不配则小程序登录返回 503，账号密码登录不受影响）
#MINIPROGRAM_APP_ID=
#MINIPROGRAM_APP_SECRET=
