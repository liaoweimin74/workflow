# Node 后端环境变量模板（复制成 .env 或直接导出为环境变量）
#
# ⚠️ 这个文件是**模板**，不会被应用自动加载：`src/framework/config/env.ts` 只读真正的
#    环境变量（默认值与这里列出的保持一致）。生产部署请用部署工具注入，别把 .env 提交进去。
#
# 参考：backend-node/README.md 的「环境变量」「部署与运维」两节。

# ---------- HTTP ----------
# 8081：保留 8080 给 DSH Web GUI、8082 给 Java 基准（契约 oracle）
PORT=8081

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=740130
# ⚠️ 默认不是 `workflow` —— 那个开发库的 Flyway 历史与仓库文件不一致（见 README「数据库」一节）。
#    契约/开发用 workflow_v6；集成测试用 workflow_node_test。
DB_NAME=workflow_v6

# ---------- JWT ----------
# ⚠️ 必须与 Java 侧一致，否则切换期间两边发的 token 不能互相识别（切换验收要验这一条）
JWT_SECRET=YnJfRFdpbjQ5dU5hZzJ4c0VvN0s2bUx4R0R4aUZ3cG1WeU9yS3F6RXhDdVN4V0E=
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_MINUTES=10080

# ---------- Redis（通知/缓存；未配置时相关能力降级） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------- 契约工具链（只在跑契约时需要，应用本身不用） ----------
# Java 基准（golden 录制目标）；Java 必须真的在跑，否则 golden:record 会整体失败
# JAVA_BASE_URL=http://localhost:8082
# Node 自身（契约比对目标）
# NODE_BASE_URL=http://localhost:8081
