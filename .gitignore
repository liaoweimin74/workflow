# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# test 目录需入库（backend/src/test 曾因裸 test 规则被整体忽略，重置后 130 个测试丢失）
/test
prompt

server.log
# Skills directory
/skills/
# MariaDB data directory (96MB redo log copies bloating repo / git OOM)
mariadb-user/
*.bundle

# session tool artifacts (never commit — may contain secrets)
tool-results/

# 本地备份目录（jar 121MB 超 GitHub 100MB 限制；db dump/截图等一并只留本地）
backups/

# 会话临时产物（冒烟脚本/兼容迁移副本/db 备份/工具快照）
tmp/
.playwright-cli/
.vscode/
cases.yaml
login.yaml

# 并行 spike 的 worktree 检出目录（只留本地，绝不进版本库）
.worktrees/

# �?Manual gitignore entries go ABOVE this line (outside auto-generated block) �?
# <!-- openspec-superpowers-opencode_gitignore -->

# Worktree isolation

.worktrees/

# OpenCode session/plugin data

.omo/

# CodeGraph index cache

.codegraph/

# OpenCode tool-generated artifacts �?track only opencode.json

.opencode/*
!.opencode/opencode.json

# Skills lock �?global Superpowers version pinning, not project code

skills.lock.json

# OpenSpec Schema �?do not track

openspec/schemas/

# OpenSpec config �?do not track

openspec/config.yaml

# OpenSpec change registry �?local dev state only

openspec/oso-change-registry.json

# Local test records

docs/test-records/*
!docs/test-records/.gitkeep

# Personal local workspace (do not track)
docs/local/

# <!-- openspec-superpowers-opencode_gitignore -->

