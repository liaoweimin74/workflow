  margin-top: 8px;
}
.lc-nested-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.lc-nested-row-ops :deep(.el-button + .el-button) {
  margin-left: 4px;
}
.lc-nested .lc-cell-item {
  margin-bottom: 0;
}
.lc-nested .lc-cell-item :deep(.el-form-item__label) {
  display: none;
}
.lc-fc-table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}
.lc-fc-table td {
  padding: 5px;
  min-width: 80px;
  min-height: 50px;
  border: 0 none;
  border-right: 1px solid #ebeef5;
  border-bottom: 1px solid #ebeef5;
  text-align: center;
  vertical-align: middle;
  overflow-wrap: break-word;
}
.lc-fc-table--no-border td {
  border: 0 none;
}
.lc-fc-table--mini td {
  padding: 0;
  min-height: 12px;
}
.lc-fc-table--mini :deep(.el-form-item) {
