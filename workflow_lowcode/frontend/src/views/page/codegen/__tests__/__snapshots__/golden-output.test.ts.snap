<script setup lang="ts">
import { reactive, ref } from 'vue'
import PageListCards from '@lc/runtime/page-list-cards'
import LookupPicker from '@lc/runtime/LookupPicker'
import DataPicker from '@lc/runtime/dataPicker'
import FormulaField from '@lc/runtime/FormulaField'
import { readCellValue } from '@lc/runtime/lookupFetch'
import { getData, createData, updateData, deleteData } from './api/cardlistpage'

// ==================== 数据源（schema.dataSources[]）====================
const ds = { id: 'ds_mvc2tj1x', refId: '25e8df2b1f1241d0a79ef33d819d0f54' }
// 逐源登记表：页面声明的几个源都在册（含未绑到组件的），人工补接线时按 id 取 refId
const dataSources = {
  'ds_mvc2tj1x': '25e8df2b1f1241d0a79ef33d819d0f54',
  'ds_mvc2tj1x1': '35bccab82a284257ad935529d518905a',
  'ds_mvc2tj1x2': '58c300fb631946c799ab07b8198a2a2b',
  'ds_mvc2tj1x3': '3a645d7c6d3847838780d8931250abcb',
}


const columns = [
  {
    prop: 'order_no',
    label: '订单编号',
    width: 130,
    align: 'left'
  },
  {
    prop: 'order_date',
    label: '下单日期',
    width: 130,
    align: 'left'
  },
  {
    prop: 'customer',
    label: '选择客户',
    width: 130,
    align: 'left'
  },
  {
    prop: 'contact_name',
    label: '联系人',
    width: 130,
    align: 'left'
  }
]

const viewActions = {
  buttons: [
    {
      key: 'edit',
      label: '编辑',
      placement: 'column',
      style: 'text',
      events: [
        {
          trigger: 'click',
          actions: []
        }
      ]
    },
    {
      key: 'delete',
      label: '删除',
      placement: 'column',
      style: 'text'
    }
  ],
  permissions: ''
}

const viewDetail = {
  width: '800px',
  type: 'form'
}

const cardStyle = {
  theme: 'default',
  base: {
    enabled: true,
    when: '',
    css: "background-color: var(--el-bg-color);\\nborder-color: var(--el-border-color-light);\\nborder-radius: 8px;\\npadding: 16px;\\ngap: 16px;\\nfont-size: 16px;\\nfont-weight: 600;\\ncolor: var(--el-text-color-primary);\\n--card-field-font-size: 14px;\\n--card-field-label-color: var(--el-text-color-secondary);\\n--card-field-value-color: var(--el-text-color-primary);"
  },
  rules: []
}

const searchColumns = [
  "name"
]

const returnFields = {
  contact: 'contact_name',
  phone: 'contact_phone'
}

const columns2 = [
  {
    prop: 'customer_code',
    label: '客户编码'
  },
  {
    prop: 'name',
    label: '客户名称'
  },
  {
    prop: 'phone',
    label: '联系电话'
  }
]

const searchColumns2 = [
  "warehouse_code",
  "name"
]

const columns3 = [
  "warehouse_code",
  "name",
  "address"
]

const itemsConfig = {
  type: 'card',
  title: '明细{index}',
  min: 1,
  button: true,
  sortBtn: true,
  max: 5
}

const searchColumns3 = [
  "product_code",
  "product_name"
]

const columns4 = [
  "product_code",
  "product_name",
  "spec"
]

const deliveryPlanConfig = {
  addable: true,
  deletable: true,
  showIndex: true,
  filterEmptyColumn: true,
  min: 1,
  max: 10
}

// ==================== 节点 n2：formContainer（schema.rule[1]）====================
const containerVisible = ref(false)
const containerReadonly = ref(false)
const containerMode = ref<'create' | 'edit' | 'view'>('create')
const containerRecordId = ref('')
const containerVersion = ref<number | undefined>(undefined)
const formRef = ref()
const form = reactive<Record<string, any>>({ order_no: '', order_date: '', customer: '', contact_name: '', contact_phone: '', warehouse: '', items: [], delivery_plan: [], invoice_info: {}, order_amount: '', discount_rate: '', due_amount: '', customer_id: '' })
const formulaApi = { api: { getValue: (field: string) => form[field] } }

/** lc:node=n2 → 打开容器并取记录（原总线 load-record / open-container 的合并语义） */
async function openContainer(recordId: string, readonly: boolean, mode: 'create' | 'edit' | 'view') {
  containerMode.value = mode
  containerReadonly.value = readonly
  containerRecordId.value = recordId
  containerVersion.value = undefined
  Object.keys(form).forEach((k) => { form[k] = '' })
  form.items = []
  form.delivery_plan = []
  form.invoice_info = {}
  containerVisible.value = true
  if (recordId) {
    const res = await getData(recordId)
    // BizDataVO = { id, version, data: {业务字段} }：字段在 vo.data 里，摊错层就是一张空表单
    const vo = (res.data ?? {}) as { version?: number; data?: Record<string, unknown> }
    const record = vo.data ?? {}
    // 只回填容器声明过的字段（对齐 DsBindingEngine.ts:79-82）：整条记录灌进 form，保存时
    // { ...form } 会把根本没在编辑的业务字段一起写回去；id/version 留在字段模型之外
    Object.keys(form).forEach((k) => { if (k in record) form[k] = record[k] })
    containerVersion.value = typeof vo.version === 'number' ? vo.version : undefined
  }
}

function closeContainer() {
  containerVisible.value = false
}

async function confirmSave() {
  if (containerMode.value === 'create') {
    await createData({ ...form })
  } else {
    await updateData(containerRecordId.value, { ...form }, containerVersion.value)
  }
  closeContainer()
  // lc:todo 列表组件未 defineExpose，取数刷新需人工接（page-list-cards 现状）
}

// ==================== 字段写回（选择器带回的显式化）====================
// 组件宿主里走 formCreateInject.api.setValue，产物没有 form-create 实例，改接 select/clear 显式赋值；
// returnFields 方向：key=被查表的源字段、value=表单目标字段（LookupPicker.vue:295-299）
/** lc:node=n2.f3 field=customer 带回 → customer_id / contact_name / contact_phone */
function onCustomerSelect(row: Record<string, unknown>) {
  form['customer_id'] = row.id ?? null
  form['contact_name'] = readCellValue(row, 'contact') ?? null
  form['contact_phone'] = readCellValue(row, 'phone') ?? null
}
function onCustomerClear() {
  form['customer_id'] = null
  form['contact_name'] = null
  form['contact_phone'] = null
}

// ==================== 行容器（group / tableForm）的增删 ====================
/** lc:node=n2.f7 type=group field=items 行增删（新行形状 = 子字段） */
function addItemsRow() { form.items.push({ product: '', qty: '', price: '', amount: '' }) }
function removeItemsRow(i: number) { form.items.splice(i, 1) }
function moveItemsRow(i: number, d: number) {
  const rows = form.items
  const j = i + d
  if (j < 0 || j >= rows.length) return
  rows.splice(j, 0, rows.splice(i, 1)[0])
}

/** lc:node=n2.f8 type=tableForm field=delivery_plan 行增删（新行形状 = 子字段） */
function addDeliveryPlanRow() { form.delivery_plan.push({ stage: '', plan_date: '', content: '', remark: '' }) }
function removeDeliveryPlanRow(i: number) { form.delivery_plan.splice(i, 1) }

// ==================== lc:behavior ← schema.actions ====================
// 原形态：[{"trigger":"row-edit","steps":[{"op":"open-container","target":"ds_mvc2tj1x"}]}]
// target 填数据源标识 → 出码时解引用成具体容器（同源画布靠前的容器），运行期不再查表
function onButtonClick(payload: { key: string; row: Record<string, unknown> | null }) {
  const row = payload.row
  switch (payload.key) {
    case 'edit':
      void openContainer(String(row?.id ?? ''), false, 'edit')
      return
    case 'delete':
      if (row?.id != null) void deleteData(String(row.id)).then(() => { /* lc:todo 列表组件未 defineExpose，取数刷新需人工接（page-list-cards 现状） */ })
      return
  }
}

function onRowClick(_row: Record<string, unknown>) {
  // schema.actions 无 row-click 触发的动作链 → 空实现，保留挂点供人工接管
}

</script>

<style scoped>
