     public Optional<Task> getTask(String taskId) {
         String tenantId = tenantProvider.getTenantId();
         Task task = flowableTaskService.createTaskQuery()
                 .taskId(taskId)
                 .taskTenantId(tenantId)
                 .singleResult();
         return Optional.ofNullable(task);
     }
 
