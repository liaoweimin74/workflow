"<!-- 由 lc-codegen 从页面 schema 出码，勿手改登记表以外的部分；人工接管写在 handler 里 -->
<template>
  <div class="lc-page">
    <el-form class="lc-page-form">
      <el-row>
        <el-col class="fc-form-col" :span="12">
          <!-- lc:node=n1 type=dash-notice field=noticeList -->
          <el-form-item>
            <dash-notice lc:node="n1" title="公告（列表）" :limit="5" display="list" :interval="4000" :span="12" height="" @ready="onDashReady" />
          </el-form-item>
        </el-col>
        <el-col class="fc-form-col" :span="12">
          <!-- lc:node=n2 type=dash-notice field=noticeCarousel -->
          <el-form-item>
            <dash-notice lc:node="n2" title="公告（轮播）" :limit="5" display="carousel" :interval="3000" :span="12" height="200px" @ready="onDashReady" />
          </el-form-item>
        </el-col>
        <el-col class="fc-form-col" :span="24">
          <!-- lc:node=n3 type=dash-filter field=filterDate -->
          <el-form-item>
            <dash-filter lc:node="n3" filter-type="date-range" field="createdAt" label="发布时间" :auto-broadcast="true" :span="24" height="" @filter-change="onFilterChange" />
          </el-form-item>
        </el-col>
      </el-row>
    </el-form>
  </div>
</template>

<script setup lang="ts">
import { reactive, ref } from 'vue'
import DashNotice from '@lc/runtime/dash-notice'
import DashFilter from '@lc/runtime/dash-filter'
import { getData, createData, updateData, deleteData } from './api/tmp-notice-verify'

// ==================== 数据源（schema.dataSources[]）====================
const ds = { id: '', refId: '' }


// ==================== dash-filter 广播（运行期 dashInstances 语义）====================
// 渲染器把 emit(ready) 的组件实例收进 dashInstances，筛选器变更时按字段条件全量 setFilter
// （PageRendererPage.vue:263-278、505-549）。产物没有渲染器，这张表由产物自己持。
const dashInstances = new Set<any>()
function onDashReady(instance: any) {
  if (instance) dashInstances.add(instance)
}
function onFilterChange(payload: { field: string; op: string; value: unknown }) {
  if (!payload?.field) return
  const cond = { [payload.field]: payload.value === null ? null : { op: payload.op, value: payload.value } }
  for (const instance of dashInstances) {
    if (instance && typeof instance.setFilter === 'function') instance.setFilter(cond)
  }
}

</script>

<style scoped>
.lc-page--stretch {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.lc-page--stretch .lc-page-form {
  height: 100%;
